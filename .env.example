# Everything below is optional. With none of it set, the app runs on
# BM25 retrieval and returns quoted passages instead of written answers.

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Where the index is persisted
# DATA_FILE=.data/library.json

# Upload limit in bytes (default 25 MB)
# MAX_UPLOAD_BYTES=26214400
